  @@index([created_at], map: "idx_role_escalation_created_at")
  @@index([current_role_id], map: "idx_role_escalation_current_role_id")
  @@index([requested_role_id], map: "idx_role_escalation_requested_role_id")
  @@index([status], map: "idx_role_escalation_status")
  @@index([user_id], map: "idx_role_escalation_user_id")
}

model role_permissions {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  granted_at    DateTime?   @default(now()) @db.Timestamptz(6)
  granted_by    String?
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@unique([role_id, permission_id], map: "unique_role_permission")
  @@index([granted_at], map: "idx_role_permissions_granted_at")
  @@index([permission_id], map: "idx_role_permissions_permission_id")
  @@index([role_id], map: "idx_role_permissions_role_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model roles {
  id                                                                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                                       String                     @unique @db.VarChar(50)
  description                                                                String?
  hierarchy_level                                                            Int?                       @default(0)
  created_at                                                                 DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at                                                                 DateTime?                  @default(now()) @db.Timestamptz(6)
  role_escalation_requests_role_escalation_requests_current_role_idToroles   role_escalation_requests[] @relation("role_escalation_requests_current_role_idToroles")
  role_escalation_requests_role_escalation_requests_requested_role_idToroles role_escalation_requests[] @relation("role_escalation_requests_requested_role_idToroles")
  role_permissions                                                           role_permissions[]
  user_roles                                                                 user_roles[]

  @@index([hierarchy_level], map: "idx_roles_hierarchy_level")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model user_roles {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String
  role_id     String    @db.Uuid
  assigned_by String?
  assigned_at DateTime? @default(now()) @db.Timestamptz(6)
  expires_at  DateTime? @db.Timestamptz(6)
  is_active   Boolean?  @default(true)
  roles       roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_role")
  users       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_user")

  @@unique([user_id, role_id], map: "unique_user_role_active")
  @@index([assigned_at], map: "idx_user_roles_assigned_at")
  @@index([expires_at], map: "idx_user_roles_expires_at")
  @@index([is_active], map: "idx_user_roles_is_active")
  @@index([role_id], map: "idx_user_roles_role_id")
  @@index([user_id], map: "idx_user_roles_user_id")
}

model CorporateAccount {
  id                                                 String              @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId                                             String              @unique @map("user_id")
  companyName                                        String              @map("company_name")
  companyRegistrationNumber                          String              @unique @map("company_registration_number")
  tinNumber                                          String?             @map("tin_number")
  businessAddress                                    String              @map("business_address")
  businessDivision                                   String              @map("business_division")
  businessDistrict                                   String              @map("business_district")
  businessUpazila                                    String?             @map("business_upazila")
  businessPostalCode                                 String?             @map("business_postal_code")
  authorizedPersonName                               String              @map("authorized_person_name")
  authorizedPersonEmail                              String              @map("authorized_person_email")
  authorizedPersonPhone                              String              @map("authorized_person_phone")
  companyEmail                                       String              @map("company_email")
  creditLimit                                        Decimal?            @map("credit_limit") @db.Decimal(12, 2)
  creditUsed                                         Decimal?            @default(0) @map("credit_used") @db.Decimal(12, 2)
  accountStatus                                      String?             @default("pending_verification") @map("account_status") @db.VarChar(50)
  verificationStatus                                 String?             @default("pending") @map("verification_status") @db.VarChar(50)
  accountManagerId                                   String?             @map("account_manager_id")
  createdAt                                          DateTime?           @default(now()) @map("created_at")
  updatedAt                                          DateTime?           @default(now()) @map("updated_at")
  verifiedAt                                         DateTime?           @map("verified_at")
  approvedBy                                         String?             @map("approved_by")
  approvedAt                                         DateTime?           @map("approved_at")
  users_corporate_accounts_account_manager_idTousers User?               @relation("corporate_accounts_account_manager_idTousers", fields: [accountManagerId], references: [id], onUpdate: NoAction, map: "fk_corporate_accounts_manager")
  users_corporate_accounts_user_idTousers            User                @relation("corporate_accounts_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_accounts_user")
  corporate_approvals                                CorporateApproval[]
  corporate_documents                                CorporateDocument[]
  corporate_pricing                                  CorporatePricing[]
  corporate_users                                    CorporateUser[]
  orders                                             Order[]

  @@map("corporate_accounts")
}

model CorporateUser {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  corporateAccountId String           @map("corporate_account_id") @db.Uuid
  userId             String           @map("user_id")
  role               String           @map("role") @db.VarChar(50)
  isActive           Boolean?         @default(true) @map("is_active")
  assignedAt         DateTime?        @default(now()) @map("assigned_at")
  expiresAt          DateTime?        @map("expires_at")
  corporate_accounts CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_users_account")
  users              User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_users_user")

  @@unique([corporateAccountId, userId], map: "unique_corporate_user")
  @@map("corporate_users")
}

model CorporateDocument {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporateAccountId String           @map("corporate_account_id") @db.Uuid
  documentType       String           @map("document_type") @db.VarChar(50)
  documentName       String           @map("document_name")
  documentUrl        String           @map("document_url")
  uploadedAt         DateTime?        @default(now()) @map("uploaded_at")
  verifiedAt         DateTime?        @map("verified_at")
  verifiedBy         String?          @map("verified_by")
  status             String?          @default("pending") @db.VarChar(50)
  corporate_accounts CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_documents_account")

  @@map("corporate_documents")
}

model CorporateApproval {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporateAccountId String           @map("corporate_account_id") @db.Uuid
  requestType        String           @map("request_type") @db.VarChar(50)
  requestedBy        String           @map("requested_by")
  requestedAmount    Decimal?         @map("requested_amount") @db.Decimal(12, 2)
  requestedAt        DateTime?        @default(now()) @map("requested_at")
  approvedBy         String?          @map("approved_by")
  approvedAt         DateTime?        @map("approved_at")
  status             String?          @default("pending") @db.VarChar(50)
  notes              String?
  corporate_accounts CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_approvals_account")

  @@map("corporate_approvals")
}

model CorporatePricing {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporateAccountId String           @map("corporate_account_id") @db.Uuid
  productId          String           @map("product_id")
  discountPercent    Decimal?         @default(0) @map("discount_percent") @db.Decimal(5, 2)
  specialPrice       Decimal?         @map("special_price") @db.Decimal(12, 2)
  validFrom          DateTime?        @default(now()) @map("valid_from")
  validTo            DateTime?        @map("valid_to")
  corporate_accounts CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_pricing_account")
  products           Product          @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_pricing_product")

  @@unique([corporateAccountId, productId], map: "unique_corporate_product_pricing")
  @@map("corporate_pricing")
}

model SearchLog {
  id            String   @id @default(uuid())
  query         String
  userId        String?
  resultsCount  Int      @default(0)
  executionTime Float    @default(0)
  filters       Json     @default("{}")
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())
  user          User?    @relation("SearchLogUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([query])
  @@map("search_logs")
}

