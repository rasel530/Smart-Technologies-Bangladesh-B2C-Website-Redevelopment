model CartSmsSubscription {
  id             String       @id @default(uuid())
  userId         String       @unique @map("user_id")
  phoneNumber    String       @map("phone_number")
  events         String[]
  isActive       Boolean      @default(true) @map("is_active")
  unsubscribedAt DateTime?    @map("unsubscribed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  smsLogs        CartSmsLog[]
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_cart_sms_subscription_user_id")
  @@index([phoneNumber], map: "idx_cart_sms_subscription_phone_number")
  @@index([isActive], map: "idx_cart_sms_subscription_is_active")
  @@index([createdAt], map: "idx_cart_sms_subscription_created_at")
  @@map("cart_sms_subscription")
}

model CartOfflineSync {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  cartId            String?  @map("cart_id")
  deviceId          String?  @map("device_id")
  lastSyncAt        DateTime @map("last_sync_at")
  version           Int      @default(1)
  syncedItemsCount  Int      @default(0) @map("synced_items_count")
  conflictsResolved Int      @default(0) @map("conflicts_resolved")
  syncStatus        String   @default("idle") @map("sync_status")
  lastError         String?  @map("last_error")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  cart              Cart?    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_cart_offline_sync_user_id")
  @@index([cartId], map: "idx_cart_offline_sync_cart_id")
  @@index([deviceId], map: "idx_cart_offline_sync_device_id")
  @@index([lastSyncAt], map: "idx_cart_offline_sync_last_sync_at")
  @@index([syncStatus], map: "idx_cart_offline_sync_sync_status")
  @@map("cart_offline_sync")
}

model CartSmsLog {
  id             String              @id @default(uuid())
  userId         String              @map("user_id")
  subscriptionId String              @map("subscription_id")
  eventType      String              @map("event_type")
  phoneNumber    String              @map("phone_number")
  messageId      String?             @map("message_id")
  status         String              @default("pending")
  errorMessage   String?             @map("error_message")
  sentAt         DateTime            @default(now()) @map("sent_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  subscription   CartSmsSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_cart_sms_log_user_id")
  @@index([subscriptionId], map: "idx_cart_sms_log_subscription_id")
  @@index([eventType], map: "idx_cart_sms_log_event_type")
  @@index([status], map: "idx_cart_sms_log_status")
  @@index([sentAt], map: "idx_cart_sms_log_sent_at")
  @@map("cart_sms_log")
}

model CheckoutSession {
  id                   String                @id @default(uuid()) @map("id")
  userId               String?               @map("user_id")
  sessionId            String?               @map("session_id")
  currentStep          String                @default("address") @map("current_step")
  shippingAddressId    String?               @map("shipping_address_id")
  billingAddressId     String?               @map("billing_address_id")
  shippingMethod       String?               @map("shipping_method")
  paymentMethod        String?               @map("payment_method")
  cartId               String                @map("cart_id")
  metadata             Json?                 @map("metadata")
  status               String                @default("active") @map("status")
  completedAt          DateTime?             @map("completed_at")
  expiresAt            DateTime?             @map("expires_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  cart                 Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  checkoutAbandonments CheckoutAbandonment[]
  shippingAddress      Address?              @relation("CheckoutSessionShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress       Address?              @relation("CheckoutSessionBillingAddress", fields: [billingAddressId], references: [id])

  @@index([sessionId], map: "idx_checkout_sessions_session_id")
  @@index([userId], map: "idx_checkout_sessions_user_id")
  @@index([cartId], map: "idx_checkout_sessions_cart_id")
  @@index([status], map: "idx_checkout_sessions_status")
  @@map("checkout_sessions")
}

model CheckoutAbandonment {
  id                  String          @id @default(uuid()) @map("id")
  checkoutSessionId   String          @map("checkout_session_id")
  userId              String?         @map("user_id")
  sessionId           String?         @map("session_id")
  abandonmentStep     String          @map("abandonment_step")
  abandonmentReason   String?         @map("abandonment_reason")
  cartValue           Decimal         @map("cart_value") @db.Decimal(12, 2)
  itemCount           Int             @map("item_count")
  recoveryEmailSent   Boolean         @default(false) @map("recovery_email_sent")
  recoveryEmailSentAt DateTime?       @map("recovery_email_sent_at")
  recovered           Boolean         @default(false) @map("recovered")
  recoveredAt         DateTime?       @map("recovered_at")
  recoveryAttempts    Int             @default(0) @map("recovery_attempts")
  ipAddress           String?         @map("ip_address")
  userAgent           String?         @map("user_agent")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  checkoutSession     CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)

  @@index([checkoutSessionId], map: "idx_checkout_abandonment_checkout_session_id")
  @@index([userId], map: "idx_checkout_abandonment_user_id")
  @@index([sessionId], map: "idx_checkout_abandonment_session_id")
  @@index([recovered], map: "idx_checkout_abandonment_recovered")
  @@map("checkout_abandonment")
}

model GuestSession {
  id                String    @id @default(uuid()) @map("id")
  sessionId         String    @unique @map("session_id")
  email             String?   @map("email")
  phone             String?   @map("phone")
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  cartId            String    @map("cart_id")
  metadata          Json?     @map("metadata")
  lastActivityAt    DateTime  @map("last_activity_at")
  expiresAt         DateTime  @map("expires_at")
  convertedToUserId String?   @map("converted_to_user_id")
  convertedAt       DateTime? @map("converted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  cart              Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_guest_sessions_session_id")
  @@index([cartId], map: "idx_guest_sessions_cart_id")
  @@index([expiresAt], map: "idx_guest_sessions_expires_at")
  @@map("guest_sessions")
}

