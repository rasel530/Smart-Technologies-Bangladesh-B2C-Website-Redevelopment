generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                              String                        @id @default(uuid())
  email                                                           String                        @unique
  emailVerified                                                   DateTime?
  phone                                                           String?                       @unique
  phoneVerified                                                   DateTime?
  password                                                        String?
  firstName                                                       String
  lastName                                                        String
  dateOfBirth                                                     DateTime?
  gender                                                          String?
  role                                                            UserRole                      @default(customer)
  status                                                          UserStatus                    @default(active)
  image                                                           String?
  createdAt                                                       DateTime                      @default(now())
  updatedAt                                                       DateTime                      @updatedAt
  lastLoginAt                                                     DateTime?
  preferredLanguage                                               String?                       @default("en")
  accountStatus                                                   String?                       @default("active")
  deletionRequestedAt                                             DateTime?
  deletionReason                                                  String?
  deletedAt                                                       DateTime?
  accountDeletionRequests                                         AccountDeletionRequests[]
  addresses                                                       Address[]
  cart                                                            Cart?
  corporate_accounts_corporate_accounts_account_manager_idTousers CorporateAccount[]            @relation("corporate_accounts_account_manager_idTousers")
  corporate_accounts_corporate_accounts_user_idTousers            CorporateAccount?             @relation("corporate_accounts_user_idTousers")
  corporate_users                                                 CorporateUser[]
  emailVerificationTokens                                         EmailVerificationToken[]
  orders                                                          Order[]
  passwordHistory                                                 PasswordHistory[]
  phoneOTPs                                                       PhoneOTP[]
  reviews                                                         Review[]
  role_escalation_requests                                        role_escalation_requests[]
  communicationPreferences                                        UserCommunicationPreferences?
  userDataExports                                                 UserDataExports[]
  notificationPreferences                                         UserNotificationPreferences?
  privacySettings                                                 UserPrivacySettings?
  user_roles                                                      user_roles[]
  userSessions                                                    UserSession[]
  socialAccounts                                                  UserSocialAccount[]
  wishlist                                                        Wishlist?

  @@map("users")
}

model Address {
  id           String      @id @default(uuid())
  userId       String
  type         AddressType @default(shipping)
  firstName    String
  lastName     String
  phone        String?
  address      String
  addressLine2 String?
  city         String
  district     String
  division     Division
  upazila      String?
  postalCode   String?
  isDefault    Boolean     @default(false)
  user         User        @relation(fields: [userId], references: [id])
  orders       Order[]

  @@map("addresses")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

model UserSocialAccount {
  id         String         @id @default(uuid())
  userId     String
  provider   SocialProvider
  providerId String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id])

  @@map("user_social_accounts")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  website     String?
  isActive    Boolean   @default(true)
  products    Product[]

  @@map("brands")
}

model Category {
  id             String     @id @default(uuid())
  name           String
  slug           String     @unique
  description    String?
  isActive       Boolean    @default(true)
  parentId       String?
  bannerImage    String?
  icon           String?
  sortOrder      Int        @default(0)
  parentCategory Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories  Category[] @relation("CategoryHierarchy")
  products       Product[]

  @@map("categories")
}

model Product {
  id                String                 @id @default(uuid())
  sku               String                 @unique
  name              String
  nameEn            String
  nameBn            String?
  slug              String                 @unique
  shortDescription  String?
  description       String?
  categoryId        String
  brandId           String
  regularPrice      Decimal                @db.Decimal(12, 2)
  salePrice         Decimal?               @db.Decimal(12, 2)
  costPrice         Decimal                @db.Decimal(12, 2)
  taxRate           Decimal                @default(0) @db.Decimal(5, 2)
  stockQuantity     Int                    @default(0)
  lowStockThreshold Int                    @default(10)
  status            ProductStatus          @default(active)
  metaTitle         String?
  metaDescription   String?
  metaKeywords      String?
  isFeatured        Boolean                @default(false)
  isNewArrival      Boolean                @default(false)
  isBestSeller      Boolean                @default(false)
  warrantyPeriod    Int?
  warrantyType      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  publishedAt       DateTime?
  cartItems         CartItem[]
  corporate_pricing CorporatePricing[]
  orderItems        OrderItem[]
  images            ProductImage[]
  specifications    ProductSpecification[]
  variants          ProductVariant[]
  brand             Brand                  @relation(fields: [brandId], references: [id])
  category          Category               @relation(fields: [categoryId], references: [id])
  reviews           Review[]
  wishlistItems     WishlistItem[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])

  @@map("product_images")
}

model ProductSpecification {
  id        String  @id @default(uuid())
  productId String
  name      String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])

  @@map("product_specifications")
}

model ProductVariant {
  id           String      @id @default(uuid())
  productId    String
  name         String
  sku          String
  price        Decimal     @db.Decimal(12, 2)
  comparePrice Decimal?    @db.Decimal(12, 2)
  stock        Int         @default(0)
  isActive     Boolean     @default(true)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  product      Product     @relation(fields: [productId], references: [id])

  @@map("product_variants")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  sessionId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  expiresAt DateTime?
  items     CartItem[]
  user      User?      @relation(fields: [userId], references: [id])

  @@map("carts")
}

model CartItem {
  id         String          @id @default(uuid())
  cartId     String
  productId  String
  variantId  String?
  quantity   Int
  unitPrice  Decimal         @db.Decimal(12, 2)
  totalPrice Decimal         @db.Decimal(12, 2)
  addedAt    DateTime        @default(now())
  cart       Cart            @relation(fields: [cartId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  name      String?
  isPrivate Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  expiresAt DateTime?
  items     WishlistItem[]
  user      User           @relation(fields: [userId], references: [id])

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  addedAt    DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id])

  @@map("wishlist_items")
}

model Order {
  id                   String            @id @default(uuid())
  orderNumber          String            @unique
  userId               String
  addressId            String
  subtotal             Decimal           @db.Decimal(12, 2)
  tax                  Decimal           @default(0) @db.Decimal(12, 2)
  shippingCost         Decimal           @default(0) @db.Decimal(12, 2)
  discount             Decimal           @default(0) @db.Decimal(12, 2)
  total                Decimal           @db.Decimal(12, 2)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus     @default(pending)
  paidAt               DateTime?
  status               OrderStatus       @default(pending)
  notes                String?
  internalNotes        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  confirmedAt          DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  corporateAccountId String?           @db.Uuid @map("corporate_account_id")
  items                OrderItem[]
  corporate_accounts   CorporateAccount? @relation(fields: [corporateAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_corporate_account")
  address              Address           @relation(fields: [addressId], references: [id])
  user                 User              @relation(fields: [userId], references: [id])
  transactions         Transaction[]

  @@map("orders")
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  productId  String
  variantId  String?
  quantity   Int
  unitPrice  Decimal         @db.Decimal(12, 2)
  totalPrice Decimal         @db.Decimal(12, 2)
  order      Order           @relation(fields: [orderId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Transaction {
  id              String        @id @default(uuid())
  orderId         String
  paymentMethod   PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("BDT")
  status          PaymentStatus @default(pending)
  transactionId   String?
  gatewayResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id])

  @@map("transactions")
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  userId     String
  rating     Int
  title      String
  comment    String?
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Coupon {
  id          String     @id @default(uuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(12, 2)
  minAmount   Decimal    @db.Decimal(12, 2)
  maxDiscount Decimal    @db.Decimal(5, 2)
  usageLimit  Int
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("coupons")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("email_verification_tokens")
}

model PhoneOTP {
  id         String    @id @default(uuid())
  userId     String?
  phone      String
  otp        String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id])

  @@map("phone_otps")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@map("password_history")
}

model UserNotificationPreferences {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  emailNotifications      Boolean  @default(true)
  smsNotifications        Boolean  @default(false)
  whatsappNotifications   Boolean  @default(false)
  marketingCommunications Boolean  @default(false)
  newsletterSubscription  Boolean  @default(false)
  notificationFrequency   String   @default("immediate")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model UserCommunicationPreferences {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  preferredLanguage      String   @default("en")
  preferredTimezone      String   @default("UTC")
  preferredContactMethod String   @default("email")
  marketingConsent       Boolean  @default(false)
  dataSharingConsent     Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_communication_preferences")
}

model UserPrivacySettings {
  id                 String             @id @default(uuid())
  userId             String             @unique
  profileVisibility  ProfileVisibility  @default(private)
  showEmail          Boolean            @default(false)
  showPhone          Boolean            @default(false)
  showAddress        Boolean            @default(false)
  allowSearchByEmail Boolean            @default(false)
  allowSearchByPhone Boolean            @default(false)
  twoFactorEnabled   Boolean            @default(false)
  twoFactorSecret    String?
  twoFactorMethod    String?
  dataSharingEnabled Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  profile_visibility ProfileVisibility? @default(public)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_privacy_settings")
}

model AccountDeletionRequests {
  id            String    @id @default(uuid())
  userId        String
  deletionToken String    @unique
  reason        String?
  status        String    @default("pending")
  requestedAt   DateTime  @default(now())
  confirmedAt   DateTime?
  completedAt   DateTime?
  expiresAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_deletion_requests")
}

model UserDataExports {
  id          String    @id @default(uuid())
  userId      String
  exportToken String    @unique
  dataTypes   Json
  format      String
  fileUrl     String?
  status      String    @default("processing")
  requestedAt DateTime  @default(now())
  readyAt     DateTime?
  expiresAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_data_exports")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique @db.VarChar(100)
  resource         String             @db.VarChar(50)
  action           String             @db.VarChar(50)
  description      String?
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]

  @@index([action], map: "idx_permissions_action")
  @@index([resource], map: "idx_permissions_resource")
  @@index([resource, action], map: "idx_permissions_resource_action")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model role_escalation_requests {
  id                                                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                                 String
  current_role_id                                         String?   @db.Uuid
  requested_role_id                                       String    @db.Uuid
  requested_by                                            String?
  status                                                  String?   @default("pending") @db.VarChar(20)
  reason                                                  String?
  reviewed_by                                             String?
  reviewed_at                                             DateTime? @db.Timestamptz(6)
  review_notes                                            String?
  created_at                                              DateTime? @default(now()) @db.Timestamptz(6)
  roles_role_escalation_requests_current_role_idToroles   roles?    @relation("role_escalation_requests_current_role_idToroles", fields: [current_role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_escalation_current_role")
  roles_role_escalation_requests_requested_role_idToroles roles     @relation("role_escalation_requests_requested_role_idToroles", fields: [requested_role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_escalation_requested_role")
  users                                                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_escalation_user")

  @@index([created_at], map: "idx_role_escalation_created_at")
  @@index([current_role_id], map: "idx_role_escalation_current_role_id")
  @@index([requested_role_id], map: "idx_role_escalation_requested_role_id")
  @@index([status], map: "idx_role_escalation_status")
  @@index([user_id], map: "idx_role_escalation_user_id")
}

model role_permissions {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  granted_at    DateTime?   @default(now()) @db.Timestamptz(6)
  granted_by    String?
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@unique([role_id, permission_id], map: "unique_role_permission")
  @@index([granted_at], map: "idx_role_permissions_granted_at")
  @@index([permission_id], map: "idx_role_permissions_permission_id")
  @@index([role_id], map: "idx_role_permissions_role_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model roles {
  id                                                                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                                       String                     @unique @db.VarChar(50)
  description                                                                String?
  hierarchy_level                                                            Int?                       @default(0)
  created_at                                                                 DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at                                                                 DateTime?                  @default(now()) @db.Timestamptz(6)
  role_escalation_requests_role_escalation_requests_current_role_idToroles   role_escalation_requests[] @relation("role_escalation_requests_current_role_idToroles")
  role_escalation_requests_role_escalation_requests_requested_role_idToroles role_escalation_requests[] @relation("role_escalation_requests_requested_role_idToroles")
  role_permissions                                                           role_permissions[]
  user_roles                                                                 user_roles[]

  @@index([hierarchy_level], map: "idx_roles_hierarchy_level")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model user_roles {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String
  role_id     String    @db.Uuid
  assigned_by String?
  assigned_at DateTime? @default(now()) @db.Timestamptz(6)
  expires_at  DateTime? @db.Timestamptz(6)
  is_active   Boolean?  @default(true)
  roles       roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_role")
  users       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_user")

  @@unique([user_id, role_id], map: "unique_user_role_active")
  @@index([assigned_at], map: "idx_user_roles_assigned_at")
  @@index([expires_at], map: "idx_user_roles_expires_at")
  @@index([is_active], map: "idx_user_roles_is_active")
  @@index([role_id], map: "idx_user_roles_role_id")
  @@index([user_id], map: "idx_user_roles_user_id")
}

model CorporateAccount {
  id                                                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  userId                                            String              @unique @map("user_id")
  companyName                                       String              @map("company_name")
  companyRegistrationNumber                        String              @unique @map("company_registration_number")
  tinNumber                                         String?              @map("tin_number")
  businessAddress                                   String              @map("business_address")
  businessDivision                                  String              @map("business_division")
  businessDistrict                                  String              @map("business_district")
  businessUpazila                                   String?              @map("business_upazila")
  businessPostalCode                               String?              @map("business_postal_code")
  authorizedPersonName                             String              @map("authorized_person_name")
  authorizedPersonEmail                            String              @map("authorized_person_email")
  authorizedPersonPhone                            String              @map("authorized_person_phone")
  companyEmail                                      String              @map("company_email")
  creditLimit                                       Decimal?            @db.Decimal(12, 2) @map("credit_limit")
  creditUsed                                        Decimal?            @default(0) @db.Decimal(12, 2) @map("credit_used")
  accountStatus                                     String?             @default("pending_verification") @db.VarChar(50) @map("account_status")
  verificationStatus                                String?             @default("pending") @db.VarChar(50) @map("verification_status")
  accountManagerId                                 String?              @map("account_manager_id")
  createdAt                                         DateTime?           @default(now()) @map("created_at")
  updatedAt                                         DateTime?           @default(now()) @map("updated_at")
  verifiedAt                                        DateTime?            @map("verified_at")
  approvedBy                                        String?              @map("approved_by")
  approvedAt                                        DateTime?            @map("approved_at")
  users_corporate_accounts_account_manager_idTousers User?               @relation("corporate_accounts_account_manager_idTousers", fields: [accountManagerId], references: [id], onUpdate: NoAction, map: "fk_corporate_accounts_manager")
  users_corporate_accounts_user_idTousers            User                @relation("corporate_accounts_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_accounts_user")
  corporate_approvals                                CorporateApproval[]
  corporate_documents                                CorporateDocument[]
  corporate_pricing                                  CorporatePricing[]
  corporate_users                                    CorporateUser[]
  orders                                             Order[]

  @@map("corporate_accounts")
}

model CorporateUser {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  corporateAccountId String           @db.Uuid @map("corporate_account_id")
  userId              String           @map("user_id")
  role                 String           @db.VarChar(50) @map("role")
  isActive            Boolean?         @default(true) @map("is_active")
  assignedAt          DateTime?        @default(now()) @map("assigned_at")
  expiresAt           DateTime?        @map("expires_at")
  corporate_accounts   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_users_account")
  users                User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_users_user")

  @@unique([corporateAccountId, userId], map: "unique_corporate_user")
  @@map("corporate_users")
}

model CorporateDocument {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporateAccountId String           @db.Uuid @map("corporate_account_id")
  documentType        String           @db.VarChar(50) @map("document_type")
  documentName        String           @map("document_name")
  documentUrl         String           @map("document_url")
  uploadedAt          DateTime?        @default(now()) @map("uploaded_at")
  verifiedAt          DateTime?        @map("verified_at")
  verifiedBy          String?          @map("verified_by")
  status               String?          @default("pending") @db.VarChar(50)
  corporate_accounts   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_documents_account")

  @@map("corporate_documents")
}

model CorporateApproval {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporateAccountId String           @db.Uuid @map("corporate_account_id")
  requestType         String           @db.VarChar(50) @map("request_type")
  requestedBy         String           @map("requested_by")
  requestedAmount     Decimal?         @db.Decimal(12, 2) @map("requested_amount")
  requestedAt         DateTime?        @default(now()) @map("requested_at")
  approvedBy          String?          @map("approved_by")
  approvedAt          DateTime?        @map("approved_at")
  status               String?          @default("pending") @db.VarChar(50)
  notes                String?
  corporate_accounts   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_approvals_account")

  @@map("corporate_approvals")
}

model CorporatePricing {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporateAccountId String           @db.Uuid @map("corporate_account_id")
  productId           String           @map("product_id")
  discountPercent     Decimal?         @default(0) @db.Decimal(5, 2) @map("discount_percent")
  specialPrice        Decimal?         @db.Decimal(12, 2) @map("special_price")
  validFrom           DateTime?        @default(now()) @map("valid_from")
  validTo             DateTime?        @map("valid_to")
  corporate_accounts   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_pricing_account")
  products             Product          @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_pricing_product")

  @@unique([corporateAccountId, productId], map: "unique_corporate_product_pricing")
  @@map("corporate_pricing")
}

