      });
    }
    
    res.status(500).json({
      success: false,
      error: 'Failed to fetch SMS subscription',
      message: 'Failed to fetch SMS subscription',
      messageBn: 'SMS সাবস্ক্রিপশন তথ্য আনতে পারা যায়নি'
    });
