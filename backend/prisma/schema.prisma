generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CartAuditLog {
  id            String   @id
  cartId        String
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  performedBy   String
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([cartId])
  @@index([createdAt])
  @@index([performedBy])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CartNote {
  id        String   @id
  cartId    String
  userId    String
  content   String
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([cartId])
}

model account_deletion_requests {
  id            String    @id
  userId        String
  deletionToken String    @unique
  reason        String?
  status        String    @default("pending")
  requestedAt   DateTime  @default(now())
  confirmedAt   DateTime?
  completedAt   DateTime?
  expiresAt     DateTime  @default(now())
  users         users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model addresses {
  id                                                                 String              @id
  userId                                                             String?
  type                                                               AddressType         @default(shipping)
  firstName                                                          String
  lastName                                                           String
  phone                                                              String?
  address                                                            String
  addressLine2                                                       String?
  city                                                               String
  district                                                           String
  division                                                           Division
  upazila                                                            String?
  postalCode                                                         String?
  isDefault                                                          Boolean             @default(false)
  users                                                              users?              @relation(fields: [userId], references: [id])
  checkout_sessions_checkout_sessions_billing_address_idToaddresses  checkout_sessions[] @relation("checkout_sessions_billing_address_idToaddresses")
  checkout_sessions_checkout_sessions_shipping_address_idToaddresses checkout_sessions[] @relation("checkout_sessions_shipping_address_idToaddresses")
  orders                                                             orders[]
}

model brands {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String      @unique
  description     String?
  address         String?
  contactEmail    String?
  contactPhone    String?
  createdAt       DateTime    @default(now())
  featuredOrder   Int         @default(0)
  isFeatured      Boolean     @default(false)
  logoUrl         String?
  metaDescription String?
  metaKeywords    String?
  metaTitle       String?
  nameBn          String?
  nameEn          String?
  status          BrandStatus @default(active)
  updatedAt       DateTime
  websiteUrl      String?
  products        products[]

  @@index([isFeatured])
  @@index([status])
  @@index([isFeatured], map: "idx_brands_is_featured")
  @@index([status], map: "idx_brands_status")
}

model cart_analytics {
  id                  String   @id
  cart_id             String   @unique
  events              Json     @default("{}")
  conversion_funnel   Json     @default("{}")
  created_at          DateTime @default(now())
  updated_at          DateTime
  abandonment_reasons Json     @default("[]")
  carts               carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  @@index([cart_id])
}

model cart_analytics_bd {
  id               String   @id
  userId           String?
  sessionId        String?
  deviceId         String
  platform         String
  deviceType       String?
  browser          String?
  networkType      String?
  networkSpeed     String?
  screenResolution String?
  cartId           String?
  action           String
  productId        String?
  paymentMethod    String?
  emiPlanId        String?
  duration         Int?
  pageCount        Int?
  touchCount       Int?
  scrollDepth      Int?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([deviceId])
  @@index([platform])
  @@index([sessionId])
  @@index([userId])
}

model cart_cleanup_audit {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String    @db.VarChar(100)
  cart_id    String?   @db.VarChar(255)
  user_id    String?   @db.VarChar(255)
  session_id String?   @db.VarChar(255)
  details    Json?     @default("{}")
  timestamp  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([cart_id], map: "idx_cart_cleanup_audit_cart_id")
  @@index([timestamp], map: "idx_cart_cleanup_audit_timestamp")
  @@index([type], map: "idx_cart_cleanup_audit_type")
  @@index([user_id], map: "idx_cart_cleanup_audit_user_id")
}

model cart_events {
  id         String   @id
  cart_id    String
  user_id    String?
  event_type String   @db.VarChar(50)
  product_id String?
  quantity   Int?
  price      Decimal? @db.Decimal(12, 2)
  timestamp  DateTime @default(now())
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  @@index([cart_id])
  @@index([cart_id, timestamp])
  @@index([event_type])
  @@index([timestamp])
  @@index([user_id])
}

model cart_items {
  id               String            @id
  cart_id          String
  product_id       String
  variant_id       String?
  quantity         Int
  price            Decimal           @db.Decimal(12, 2)
  subtotal         Decimal           @db.Decimal(12, 2)
  added_at         DateTime          @default(now())
  carts            carts             @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  products         products          @relation(fields: [product_id], references: [id])
  product_variants product_variants? @relation(fields: [variant_id], references: [id])

  @@index([cart_id])
  @@index([product_id])
  @@index([variant_id])
}

model cart_offline_sync {
  id                 String   @id
  user_id            String
  cart_id            String?
  device_id          String?
  last_sync_at       DateTime
  version            Int      @default(1)
  synced_items_count Int      @default(0)
  conflicts_resolved Int      @default(0)
  sync_status        String   @default("idle")
  last_error         String?
  created_at         DateTime @default(now())
  updated_at         DateTime
  carts              carts?   @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  users              users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([cart_id], map: "idx_cart_offline_sync_cart_id")
  @@index([device_id], map: "idx_cart_offline_sync_device_id")
  @@index([last_sync_at], map: "idx_cart_offline_sync_last_sync_at")
  @@index([sync_status], map: "idx_cart_offline_sync_sync_status")
  @@index([user_id], map: "idx_cart_offline_sync_user_id")
}

model cart_recovery_events {
  id         String   @id
  cart_id    String
  event_type String   @db.VarChar(50)
  email      String?  @db.VarChar(255)
  ip_address String?  @db.VarChar(45)
  user_agent String?
  metadata   Json?
  created_at DateTime @default(now())
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  @@index([cart_id], map: "idx_cart_recovery_events_cart_id")
  @@index([created_at], map: "idx_cart_recovery_events_created_at")
  @@index([event_type], map: "idx_cart_recovery_events_event_type")
}

model cart_recovery_settings {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enabled                    Boolean  @default(true)
  first_email_delay          Int      @default(1)
  second_email_delay         Int      @default(24)
  third_email_delay          Int      @default(72)
  discount_enabled           Boolean  @default(true)
  discount_percentage        Int      @default(10)
  discount_code              String   @default("COMEBACK10") @db.VarChar(50)
  max_recovery_attempts      Int      @default(3)
  min_cart_value             Decimal  @default(1000) @db.Decimal(12, 2)
  email_from_name            String   @default("Smart Tech") @db.VarChar(100)
  email_from_address         String   @default("noreply@smarttech.com") @db.VarChar(255)
  cart_abandonment_threshold Int      @default(30)
  recovery_token_expiry      Int      @default(7)
  created_at                 DateTime @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime @default(now()) @db.Timestamptz(6)

  @@index([updated_at], map: "idx_cart_recovery_settings_updated")
}

model cart_share_tokens {
  id         String   @id
  cart_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  @@index([cart_id])
  @@index([expires_at])
  @@index([token])
}

model cart_sms_log {
  id                    String                @id
  user_id               String
  subscription_id       String
  event_type            String
  phone_number          String
  message_id            String?
  status                String                @default("pending")
  error_message         String?
  sent_at               DateTime              @default(now())
  created_at            DateTime              @default(now())
  cart_sms_subscription cart_sms_subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  users                 users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([event_type], map: "idx_cart_sms_log_event_type")
  @@index([sent_at], map: "idx_cart_sms_log_sent_at")
  @@index([status], map: "idx_cart_sms_log_status")
  @@index([subscription_id], map: "idx_cart_sms_log_subscription_id")
  @@index([user_id], map: "idx_cart_sms_log_user_id")
}

model cart_sms_subscription {
  id              String         @id
  user_id         String         @unique
  phone_number    String
  events          String[]
  is_active       Boolean        @default(true)
  unsubscribed_at DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime
  cart_sms_log    cart_sms_log[]
  users           users          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at], map: "idx_cart_sms_subscription_created_at")
  @@index([is_active], map: "idx_cart_sms_subscription_is_active")
  @@index([phone_number], map: "idx_cart_sms_subscription_phone_number")
  @@index([user_id], map: "idx_cart_sms_subscription_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cart_wishlist_move_history {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String
  product_id     String
  quantity       Int?      @default(1)
  source_id      String?
  destination_id String?
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  move_type      MoveType?
  products       products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_move_history_created_at")
  @@index([destination_id], map: "idx_move_history_destination_id")
  @@index([product_id], map: "idx_move_history_product_id")
  @@index([source_id], map: "idx_move_history_source_id")
  @@index([user_id], map: "idx_move_history_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cart_wishlist_sync {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String
  cart_id       String?
  wishlist_id   String?
  last_sync_at  DateTime?   @db.Timestamp(6)
  error_message String?
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  updated_at    DateTime    @default(now()) @db.Timestamp(6)
  sync_status   SyncStatus?
  carts         carts?      @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wishlists     wishlists?  @relation(fields: [wishlist_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cart_id], map: "idx_cart_wishlist_sync_cart_id")
  @@index([last_sync_at(sort: Desc)], map: "idx_cart_wishlist_sync_last_sync")
  @@index([user_id], map: "idx_cart_wishlist_sync_user_id")
  @@index([wishlist_id], map: "idx_cart_wishlist_sync_wishlist_id")
}

model carts {
  id                     String                 @id
  user_id                String?                @unique
  session_id             String?
  created_at             DateTime               @default(now())
  updated_at             DateTime
  expires_at             DateTime?
  subtotal               Decimal                @default(0) @db.Decimal(12, 2)
  tax                    Decimal                @default(0) @db.Decimal(12, 2)
  shipping_cost          Decimal                @default(0) @db.Decimal(12, 2)
  discount               Decimal                @default(0) @db.Decimal(12, 2)
  total                  Decimal                @default(0) @db.Decimal(12, 2)
  status                 CartStatus             @default(active)
  abandoned_at           DateTime?
  recovered_at           DateTime?
  recovery_token         String?                @unique @db.VarChar(255)
  recovery_token_expires DateTime?
  recovery_attempts      Int                    @default(0)
  recovery_email_sent_at DateTime?
  reminder_count         Int                    @default(0)
  last_reminder_at       DateTime?
  abandonment_reason     String?                @db.VarChar(255)
  recovery_notes         String?
  discount_code          String?                @db.VarChar(50)
  discount_amount        Decimal?               @db.Decimal(10, 2)
  last_recovery_at       DateTime?
  device_id              String?
  cart_analytics         cart_analytics?
  cart_events            cart_events[]
  cart_items             cart_items[]
  cart_offline_sync      cart_offline_sync[]
  cart_recovery_events   cart_recovery_events[]
  cart_share_tokens      cart_share_tokens[]
  cart_wishlist_sync     cart_wishlist_sync[]
  users                  users?                 @relation(fields: [user_id], references: [id])
  checkout_sessions      checkout_sessions[]
  guest_sessions         guest_sessions[]

  @@index([device_id])
  @@index([expires_at])
  @@index([session_id])
  @@index([status])
  @@index([user_id])
  @@index([abandoned_at], map: "idx_carts_abandoned_at")
  @@index([last_recovery_at], map: "idx_carts_last_recovery_at")
  @@index([recovered_at], map: "idx_carts_recovered_at")
  @@index([recovery_token], map: "idx_carts_recovery_token")
}

model categories {
  id                 String               @id
  name               String
  slug               String               @unique
  description        String?
  parentId           String?
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  displayOrder       Int                  @default(0)
  iconUrl            String?
  imageUrl           String?
  metaDescription    String?
  metaKeywords       String?
  metaTitle          String?
  nameBn             String?
  nameEn             String?
  status             CategoryStatus       @default(active)
  updatedAt          DateTime
  categories         categories?          @relation("categoriesTocategories", fields: [parentId], references: [id], onDelete: Cascade)
  other_categories   categories[]         @relation("categoriesTocategories")
  product_categories product_categories[]

  @@index([parentId])
  @@index([status])
  @@index([parentId], map: "idx_categories_parent_id")
  @@index([status], map: "idx_categories_status")
}

model checkout_abandonment {
  id                     String            @id
  checkout_session_id    String
  user_id                String?
  session_id             String?
  abandonment_step       String
  abandonment_reason     String?
  cart_value             Decimal           @db.Decimal(12, 2)
  item_count             Int
  recovery_email_sent    Boolean           @default(false)
  recovery_email_sent_at DateTime?
  recovered              Boolean           @default(false)
  recovered_at           DateTime?
  recovery_attempts      Int               @default(0)
  ip_address             String?
  user_agent             String?
  created_at             DateTime          @default(now())
  updated_at             DateTime
  checkout_sessions      checkout_sessions @relation(fields: [checkout_session_id], references: [id], onDelete: Cascade)

  @@index([checkout_session_id], map: "idx_checkout_abandonment_checkout_session_id")
  @@index([recovered], map: "idx_checkout_abandonment_recovered")
  @@index([session_id], map: "idx_checkout_abandonment_session_id")
  @@index([user_id], map: "idx_checkout_abandonment_user_id")
}

model checkout_sessions {
  id                                                         String                 @id
  user_id                                                    String?
  session_id                                                 String?
  current_step                                               String                 @default("address")
  shipping_address_id                                        String?
  billing_address_id                                         String?
  shipping_method                                            String?
  payment_method                                             String?
  cart_id                                                    String
  metadata                                                   Json?
  status                                                     String                 @default("active")
  completed_at                                               DateTime?
  expires_at                                                 DateTime?
  created_at                                                 DateTime               @default(now())
  updated_at                                                 DateTime
  abandonment_id                                             String?
  order_id                                                   String?
  progress                                                   Json?
  step_data                                                  Json?
  checkout_abandonment                                       checkout_abandonment[]
  addresses_checkout_sessions_billing_address_idToaddresses  addresses?             @relation("checkout_sessions_billing_address_idToaddresses", fields: [billing_address_id], references: [id])
  carts                                                      carts                  @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  addresses_checkout_sessions_shipping_address_idToaddresses addresses?             @relation("checkout_sessions_shipping_address_idToaddresses", fields: [shipping_address_id], references: [id])

  @@index([cart_id], map: "idx_checkout_sessions_cart_id")
  @@index([order_id], map: "idx_checkout_sessions_order_id")
  @@index([session_id], map: "idx_checkout_sessions_session_id")
  @@index([status], map: "idx_checkout_sessions_status")
  @@index([user_id], map: "idx_checkout_sessions_user_id")
}

model checkout_settings {
  id                              String   @id
  sessionTimeout                  Int      @default(1800)
  abandonmentEnabled              Boolean  @default(true)
  abandonmentTimeout              Int      @default(30)
  abandonmentCheckInterval        Int      @default(5)
  recoveryEmailEnabled            Boolean  @default(true)
  recoveryEmailDelay              Int      @default(30)
  recoveryEmailMaxAttempts        Int      @default(3)
  guestCheckoutEnabled            Boolean  @default(true)
  guestRequireEmail               Boolean  @default(true)
  guestRequirePhone               Boolean  @default(false)
  guestMaxSessionDuration         Int      @default(3600)
  guestAllowAccountCreation       Boolean  @default(true)
  securityRequireAuthForHighValue Boolean  @default(true)
  securityHighValueThreshold      Decimal  @default(1000) @db.Decimal(12, 2)
  securityEnableFraudDetection    Boolean  @default(false)
  mobileEnabled                   Boolean  @default(true)
  mobileOptimizeForMobile         Boolean  @default(true)
  mobileShowMobileOptimizedUI     Boolean  @default(true)
  stepsCartEnabled                Boolean  @default(true)
  stepsCartRequired               Boolean  @default(true)
  stepsShippingEnabled            Boolean  @default(true)
  stepsShippingRequired           Boolean  @default(true)
  stepsBillingEnabled             Boolean  @default(true)
  stepsBillingRequired            Boolean  @default(true)
  stepsPaymentEnabled             Boolean  @default(true)
  stepsPaymentRequired            Boolean  @default(true)
  stepsReviewEnabled              Boolean  @default(true)
  stepsReviewRequired             Boolean  @default(false)
  stepsConfirmationEnabled        Boolean  @default(true)
  stepsConfirmationRequired       Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime
}

model cod_settings {
  id                           String   @id
  is_enabled                   Boolean  @default(true)
  min_amount                   Decimal  @default(0) @db.Decimal(12, 2)
  max_amount                   Decimal  @default(100000) @db.Decimal(12, 2)
  available_divisions          String[] @default(["dhaka", "chittagong", "khulna", "rajshahi", "sylhet", "barishal", "rangpur", "mymensingh"])
  unavailable_divisions        String[] @default([])
  additional_fee               Decimal  @default(0) @db.Decimal(12, 2)
  free_above_amount            Decimal  @default(0) @db.Decimal(12, 2)
  require_phone_verification   Boolean  @default(false)
  require_address_verification Boolean  @default(false)
  max_daily_orders             Int      @default(5)
  max_weekly_orders            Int      @default(10)
  delivery_days                Int      @default(3)
  notes                        String?
  created_at                   DateTime @default(now())
  updated_at                   DateTime
}

model comparison_history {
  id           String   @id
  userId       String
  comparisonId String
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())
  users        users    @relation(fields: [userId], references: [id])

  @@index([comparisonId])
  @@index([createdAt])
  @@index([userId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model comparison_share_tokens {
  id                  String              @id @default(dbgenerated("gen_random_uuid()"))
  comparison_id       String
  token               String              @unique
  expires_at          DateTime
  created_at          DateTime            @default(now())
  product_comparisons product_comparisons @relation(fields: [comparison_id], references: [id], onDelete: Cascade)

  @@index([comparison_id])
  @@index([expires_at])
}

model corporate_accounts {
  id                                                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                            String                @unique
  company_name                                       String
  company_registration_number                        String                @unique
  tin_number                                         String?
  business_address                                   String
  business_division                                  String
  business_district                                  String
  business_upazila                                   String?
  business_postal_code                               String?
  authorized_person_name                             String
  authorized_person_email                            String
  authorized_person_phone                            String
  company_email                                      String
  credit_limit                                       Decimal?              @db.Decimal(12, 2)
  credit_used                                        Decimal?              @default(0) @db.Decimal(12, 2)
  account_status                                     String?               @default("pending_verification") @db.VarChar(50)
  verification_status                                String?               @default("pending") @db.VarChar(50)
  account_manager_id                                 String?
  created_at                                         DateTime?             @default(now())
  updated_at                                         DateTime?             @default(now())
  verified_at                                        DateTime?
  approved_by                                        String?
  approved_at                                        DateTime?
  users_corporate_accounts_account_manager_idTousers users?                @relation("corporate_accounts_account_manager_idTousers", fields: [account_manager_id], references: [id], onUpdate: NoAction, map: "fk_corporate_accounts_manager")
  users_corporate_accounts_user_idTousers            users                 @relation("corporate_accounts_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_accounts_user")
  corporate_approvals                                corporate_approvals[]
  corporate_documents                                corporate_documents[]
  corporate_pricing                                  corporate_pricing[]
  corporate_users                                    corporate_users[]
  orders                                             orders[]
}

model corporate_approvals {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporate_account_id String             @db.Uuid
  request_type         String             @db.VarChar(50)
  requested_by         String
  requested_amount     Decimal?           @db.Decimal(12, 2)
  requested_at         DateTime?          @default(now())
  approved_by          String?
  approved_at          DateTime?
  status               String?            @default("pending") @db.VarChar(50)
  notes                String?
  corporate_accounts   corporate_accounts @relation(fields: [corporate_account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_corporate_approvals_account")
}

model corporate_documents {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
