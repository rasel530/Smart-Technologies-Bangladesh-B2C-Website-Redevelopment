const express = require('express');
const { body, param, validationResult } = require('express-validator');
const { authMiddleware } = require('../../middleware/auth');
const { rateLimitService } = require('../../services/rateLimitService');
const { localPaymentService } = require('../../services/localPaymentService');
const { loggerService } = require('../../services/logger');

// Logger for admin local payment routes
const adminLocalPaymentLogger = {
  info: (message, data) => loggerService.info(message, data),
  warn: (message, data) => loggerService.warn(message, data),
  error: (message, data) => loggerService.error(message, data)
};

const router = express.Router();

// Rate limiting configuration for admin local payment endpoints
const adminLocalPaymentRateLimitConfig = {
  windowMs: 15 * 60 * 1000, // 15 minutes
  maxRequests: 100,
  message: 'Too many admin requests. Please try again later.',
  messageBn: 'অনেক কার্য অপারেশন। অনুগ্রহ করে পুনরায় চেষ্টা করুন।',
  skipSuccessfulRequests: false
};

// Create rate limiting middleware
const adminLocalPaymentRateLimit = rateLimitService.createRateLimit(adminLocalPaymentRateLimitConfig);

// Validation middleware
const handleValidationErrors = (req, res, next) => {
  const errors = validationResult(req);
  if (!errors.isEmpty()) {
    return res.status(400).json({
      success: false,
      error: 'Validation failed',
      message: 'Validation failed',
      messageBn: 'যাচাইকরণ ব্যর্থ হয়েছে',
      details: errors.array()
    });
  }
  next();
};

// ============================================================================
// Payment Method Management Endpoints
// ============================================================================

/**
 * GET /api/v1/admin/local-payment/methods
 * List all payment methods
 */
router.get('/methods', [
  // No validation required for GET
], async (req, res) => {
  try {
    const methods = await localPaymentService.getLocalPaymentMethods();
    
    res.json({
      success: true,
      message: 'Payment methods retrieved successfully',
      messageBn: 'পেমেন্ট পদ্ধতি তালিকা সফলভাবে পুনরুন',
      data: methods
    });
  } catch (error) {
    adminLocalPaymentLogger.error('[GET /admin/local-payment/methods] Error fetching payment methods', {
      error: error.message,
      code: error.code,
      name: error.name,
      stack: error.stack
    });
    res.status(500).json({
      success: false,
      error: 'Failed to fetch payment methods',
      message: 'Failed to fetch payment methods',
      messageBn: 'পেমেন্ট পদ্ধতি তালিকা আনতে পারা যায়নি'
    });
  }
});

/**
 * POST /api/v1/admin/local-payment/methods
 * Create payment method
 */
router.post('/methods', [
  body('name').isString().notEmpty().withMessage('Name is required'),
  body('code').isString().notEmpty().withMessage('Code is required'),
  body('displayName').isString().notEmpty().withMessage('Display name is required'),
  body('minAmount').isFloat({ min: 0 }).withMessage('Invalid minimum amount'),
  body('maxAmount').isFloat({ min: 0 }).withMessage('Invalid maximum amount'),
  body('processingFee').isFloat({ min: 0 }).withMessage('Invalid processing fee'),
  body('processingFeePercent').isFloat({ min: 0, max: 100 }).withMessage('Invalid processing fee percent'),
  body('requiresPhone').isBoolean().withMessage('Invalid requires phone flag'),
  body('requiresPin').isBoolean().withMessage('Invalid requires PIN flag'),
  body('supportedNetworks').isArray().withMessage('Supported networks must be an array')
], handleValidationErrors, authMiddleware.authenticate, adminLocalPaymentRateLimit, async (req, res) => {
  try {
    const methodData = req.body;
    
    const method = await localPaymentService.createPaymentMethod(methodData);
    
    res.status(201).json({
      success: true,
      message: 'Payment method created successfully',
      messageBn: 'পেমেন্ট পদ্ধতি সফলভাবে তৈরি করা হয়েছে',
      data: method
    });
  } catch (error) {
    adminLocalPaymentLogger.error('[POST /admin/local-payment/methods] Error creating payment method', {
      error: error.message,
      code: error.code,
      name: error.name,
      stack: error.stack
    });
    res.status(500).json({
      success: false,
      error: 'Failed to create payment method',
      message: 'Failed to create payment method',
      messageBn: 'পেমেন্ট পদ্ধতি তৈরি করতে ব্যর্থ হয়েছে'
    });
  }
});

/**
 * PUT /api/v1/admin/local-payment/methods/:id
 * Update payment method
 */
router.put('/methods/:id', [
  param('id').isString().notEmpty().withMessage('Invalid method ID'),
  body('name').optional().isString(),
  body('displayName').optional().isString(),
  body('logoUrl').optional().isString(),
  body('isActive').optional().isBoolean(),
  body('minAmount').optional().isFloat({ min: 0 }),
  body('maxAmount').optional().isFloat({ min: 0 }),
  body('processingFee').optional().isFloat({ min: 0 }),
  body('processingFeePercent').optional().isFloat({ min: 0, max: 100 }),
  body('requiresPhone').optional().isBoolean(),
  body('requiresPin').optional().isBoolean(),
  body('description').optional().isString(),
  body('instructions').optional().isString(),
  body('supportedNetworks').optional().isArray()
], handleValidationErrors, authMiddleware.authenticate, adminLocalPaymentRateLimit, async (req, res) => {
  try {
    const { id } = req.params;
    const updateData = req.body;
    
    const method = await localPaymentService.updatePaymentMethod(id, updateData);
    
    res.json({
      success: true,
      message: 'Payment method updated successfully',
      messageBn: 'পেমেন্ট পদ্ধতি সফলভাবে আপডেট করা হয়েছে',
      data: method
    });
  } catch (error) {
    adminLocalPaymentLogger.error('[PUT /admin/local-payment/methods/:id] Error updating payment method', {
      id: req.params.id,
      error: error.message,
      code: error.code,
      name: error.name,
      stack: error.stack
    });
    
    if (error.message.includes('not found')) {
      return res.status(404).json({
        success: false,
        error: 'Payment method not found',
        message: 'Payment method not found',
        messageBn: 'পেমেন্ট পদ্ধতি তথ্য পাওয়া যায়নি'
      });
    }
    
    res.status(500).json({
      success: false,
      error: 'Failed to update payment method',
      message: 'Failed to update payment method',
      messageBn: 'পেমেন্ট পদ্ধতি আপডেট করতে ব্যর্থ হয়েছে'
    });
  }
});

/**
 * DELETE /api/v1/admin/local-payment/methods/:id
 * Delete payment method
 */
router.delete('/methods/:id', [
  param('id').isString().notEmpty().withMessage('Invalid method ID')
], handleValidationErrors, authMiddleware.authenticate, adminLocalPaymentRateLimit, async (req, res) => {
  try {
    const { id } = req.params;
    
    await localPaymentService.deletePaymentMethod(id);
    
    res.json({
      success: true,
      message: 'Payment method deleted successfully',
      messageBn: 'পেমেন্ট পদ্ধতি সফলভাবে মুছে ফেলা হয়েছে'
    });
  } catch (error) {
    adminLocalPaymentLogger.error('[DELETE /admin/local-payment/methods/:id] Error deleting payment method', {
      id: req.params.id,
      error: error.message,
      code: error.code,
      name: error.name,
      stack: error.stack
    });
    
    if (error.message.includes('not found')) {
      return res.status(404).json({
        success: false,
        error: 'Payment method not found',
        message: 'Payment method not found',
        messageBn: 'পেমেন্ট পদ্ধতি তথ্য পাওয়া যায়নি'
      });
    }
    
    res.status(500).json({
      success: false,
      error: 'Failed to delete payment method',
      message: 'Failed to delete payment method',
      messageBn: 'পেমেন্ট পদ্ধতি মুছে ফেলতে ব্যর্থ হয়েছে'
    });
  }
});

// ============================================================================
// SMS Subscription Management Endpoints
// ============================================================================

/**
 * GET /api/v1/admin/local-payment/sms-subscriptions
 * List all SMS subscriptions
 */
router.get('/sms-subscriptions', [
  // No validation required for GET
], adminLocalPaymentRateLimit, async (req, res) => {
  try {
    const subscriptions = await localPaymentService.getAllSmsSubscriptions();
    
    res.json({
      success: true,
      message: 'SMS subscriptions retrieved successfully',
      messageBn: 'SMS সাবস্ক্রিপশন তালিকা সফলভাবে পুনরুন',
      data: subscriptions
    });
  } catch (error) {
    adminLocalPaymentLogger.error('[GET /admin/local-payment/sms-subscriptions] Error fetching SMS subscriptions', {
      error: error.message,
      code: error.code,
      name: error.name,
      stack: error.stack
    });
    res.status(500).json({
      success: false,
      error: 'Failed to fetch SMS subscriptions',
      message: 'Failed to fetch SMS subscriptions',
      messageBn: 'SMS সাবস্ক্রিপশন তালিকা আনতে পারা যায়নি'
    });
  }
});

/**
