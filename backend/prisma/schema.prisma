  userId        String    @map("user_id")
  productId     String    @map("product_id")
  quantity      Int?      @default(1)
  sourceId      String?   @map("source_id")
  destinationId String?   @map("destination_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  moveType      MoveType? @map("move_type")
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_move_history_created_at")
  @@index([destinationId], map: "idx_move_history_destination_id")
  @@index([productId], map: "idx_move_history_product_id")
  @@index([sourceId], map: "idx_move_history_source_id")
  @@index([userId], map: "idx_move_history_user_id")
  @@map("cart_wishlist_move_history")
}

model EmiProvider {
  id            String    @id
  code          String    @unique
  name          String
  logoUrl       String?   @map("logo_url")
  website       String?
  isActive      Boolean   @default(true) @map("is_active")
  minAmount     Decimal   @map("min_amount") @db.Decimal(12, 2)
  maxAmount     Decimal   @map("max_amount") @db.Decimal(12, 2)
  processingFee Decimal   @default(0) @map("processing_fee") @db.Decimal(12, 2)
  interestRate  Decimal   @default(0) @map("interest_rate") @db.Decimal(5, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  emiPlans      EmiPlan[]

  @@index([isActive], map: "idx_emi_providers_is_active")
  @@map("emi_providers")
}

model EmiPlan {
  id            String      @id
  providerId    String      @map("provider_id")
  code          String      @unique @map("code")
  name          String
  duration      Int
  interestRate  Decimal     @map("interest_rate") @db.Decimal(5, 2)
  minAmount     Decimal     @map("min_amount") @db.Decimal(12, 2)
  maxAmount     Decimal     @map("max_amount") @db.Decimal(12, 2)
  processingFee Decimal     @default(0) @map("processing_fee") @db.Decimal(12, 2)
  downPayment   Decimal     @default(0) @map("down_payment") @db.Decimal(12, 2)
  isActive      Boolean     @default(true) @map("is_active")
  displayOrder  Int         @default(0) @map("display_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  provider      EmiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([isActive], map: "idx_emi_plans_is_active")
  @@index([providerId], map: "idx_emi_plans_provider_id")
  @@map("emi_plans")
}

model CodSettings {
  id                           String   @id @default(uuid())
  is_enabled                   Boolean  @default(true)
  min_amount                   Decimal  @default(0) @db.Decimal(12, 2)
  max_amount                   Decimal  @default(100000) @db.Decimal(12, 2)
  available_divisions          String[] @default(["dhaka", "chittagong", "khulna", "rajshahi", "sylhet", "barishal", "rangpur", "mymensingh"])
  unavailable_divisions        String[] @default([])
  additional_fee               Decimal  @default(0) @db.Decimal(12, 2)
  free_above_amount            Decimal  @default(0) @db.Decimal(12, 2)
  require_phone_verification   Boolean  @default(false)
  require_address_verification Boolean  @default(false)
  max_daily_orders             Int      @default(5)
  max_weekly_orders            Int      @default(10)
  delivery_days                Int      @default(3)
  notes                        String?
  created_at                   DateTime @default(now())
  updated_at                   DateTime

  @@map("cod_settings")
}

model LocalPaymentMethod {
  id                   String   @id @default(uuid())
  name                 String
  code                 String   @unique
  displayName          String
  logoUrl              String?
  isActive             Boolean  @default(true)
  minAmount            Decimal  @default(10) @db.Decimal(12, 2)
  maxAmount            Decimal  @default(200000) @db.Decimal(12, 2)
  processingFee        Decimal  @default(0) @db.Decimal(12, 2)
  processingFeePercent Decimal  @default(0) @db.Decimal(5, 2)
  requiresPhone        Boolean  @default(true)
  requiresPin          Boolean  @default(false)
  description          String?
  instructions         String?
  supportedNetworks    String[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive])
  @@map("local_payment_methods")
}

model SmsSubscription {
  id            String    @id @default(uuid())
  userId        String    @unique
  phoneNumber   String    @unique
  paymentMethod String
  isSubscribed  Boolean   @default(true)
  transactionId String?
  lastPaymentAt DateTime?
  nextPaymentAt DateTime?
  amount        Decimal   @db.Decimal(12, 2)
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([paymentMethod])
  @@map("sms_subscriptions")
}

model OfflineCartChange {
  id             String    @id @default(uuid())
  userId         String?
  sessionId      String?
  deviceId       String
  action         String
  productId      String?
  variantId      String?
  quantity       Int?
  previousValue  Json?
  newValue       Json?
  isSynced       Boolean   @default(false)
  syncedAt       DateTime?
  failedAttempts Int       @default(0)
  errorMessage   String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([deviceId])
  @@index([isSynced])
  @@map("offline_cart_changes")
}

model CartAnalyticsBd {
  id               String   @id @default(uuid())
  userId           String?
  sessionId        String?
  deviceId         String
  platform         String
  deviceType       String?
  browser          String?
  networkType      String?
  networkSpeed     String?
  screenResolution String?
  cartId           String?
  action           String
  productId        String?
  paymentMethod    String?
  emiPlanId        String?
  duration         Int?
  pageCount        Int?
  touchCount       Int?
  scrollDepth      Int?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([deviceId])
  @@index([platform])
  @@index([action])
  @@index([createdAt])
