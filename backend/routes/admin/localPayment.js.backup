});

/**
 * PUT /api/v1/admin/local-payment/sms-subscriptions/:id
 * Update SMS subscription
 */
router.put('/sms-subscriptions/:id', [
  param('id').isString().notEmpty().withMessage('Invalid subscription ID'),
  body('isSubscribed').optional().isBoolean(),
  body('phoneNumber').optional().isString(),
  body('paymentMethod').optional().isString(),
  body('amount').optional().isFloat({ min: 0 }),
  body('status').optional().isString()
], handleValidationErrors, authMiddleware.authenticate, adminLocalPaymentRateLimit, async (req, res) => {
  try {
    const { id } = req.params;
    const updateData = req.body;
    
    const subscription = await localPaymentService.updateSmsSubscription(id, updateData);
    
    res.json({
      success: true,
      message: 'SMS subscription updated successfully',
      messageBn: 'SMS সাবস্ক্রিপশন সফলভাবে আপডেট করা হয়েছে',
      data: subscription
    });
  } catch (error) {
    adminLocalPaymentLogger.error('[PUT /admin/local-payment/sms-subscriptions/:id] Error updating SMS subscription', {
      id: req.params.id,
      error: error.message,
      code: error.code,
      name: error.name,
      stack: error.stack
    });
    
    if (error.message.includes('not found')) {
      return res.status(404).json({
        success: false,
        error: 'SMS subscription not found',
        message: 'SMS subscription not found',
        messageBn: 'SMS সাবস্ক্রিপশন তথ্য পাওয়া যায়নি'
      });
    }
    
    res.status(500).json({
      success: false,
      error: 'Failed to update SMS subscription',
      message: 'Failed to update SMS subscription',
      messageBn: 'SMS সাবস্ক্রিপশন আপডেট করতে ব্যর্থ হয়েছে'
    });
  }
});

/**
 * DELETE /api/v1/admin/local-payment/sms-subscriptions/:id
 * Cancel SMS subscription
 */
router.delete('/sms-subscriptions/:id', [
  param('id').isString().notEmpty().withMessage('Invalid subscription ID')
], handleValidationErrors, authMiddleware.authenticate, adminLocalPaymentRateLimit, async (req, res) => {
  try {
    const { id } = req.params;
    const subscription = await localPaymentService.cancelSmsSubscription(id);
    
    res.json({
      success: true,
      message: 'SMS subscription cancelled successfully',
      messageBn: 'SMS সাবস্ক্রিপশন সফলভাবে বাতিল করা হয়েছে',
      data: subscription
    });
  } catch (error) {
    adminLocalPaymentLogger.error('[DELETE /admin/local-payment/sms-subscriptions/:id] Error cancelling SMS subscription', {
      id: req.params.id,
      error: error.message,
      code: error.code,
      name: error.name,
      stack: error.stack
    });
    
    if (error.message.includes('not found')) {
      return res.status(404).json({
        success: false,
        error: 'SMS subscription not found',
        message: 'SMS subscription not found',
        messageBn: 'SMS সাবস্ক্রিপশন তথ্য পাওয়া যায়নি'
      });
    }
    
    res.status(500).json({
      success: false,
      error: 'Failed to cancel SMS subscription',
      message: 'Failed to cancel SMS subscription',
      messageBn: 'SMS সাবস্ক্রিপশন বাতিল করতে ব্যর্থ হয়েছে'
    });
  }
});

module.exports = router;
