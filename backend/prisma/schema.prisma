  roles_role_escalation_requests_requested_role_idToroles roles     @relation("role_escalation_requests_requested_role_idToroles", fields: [requested_role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_escalation_requested_role")
